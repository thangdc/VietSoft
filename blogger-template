<b:skin><![CDATA[/*
---------------------------------------------------------------
ThangDC Theme V2.1 — Homepage rebuilt from the approved HTML mockup
Visual reference: Downloads/gemini-code-*.html (= theme.html, image version)
Design language: light / white cards / primary #2563eb / Inter
Homepage sections:
  Header -> Hero -> Featured Articles -> Topics -> What I Build (Projects)
  -> Free Tools -> Latest Articles -> CTA -> About -> Footer
Post pages reuse the same design tokens.
Layout is full-width (max 1200px centered), NO sidebar on homepage.
--------------------------------------------------------------- */

:root{
  --td-bg:#f8fafc;
  --td-surface:#ffffff;
  --td-border:#e2e8f0;
  --td-border-strong:#cbd5e1;
  --td-text:#0f172a;
  --td-text-soft:#475569;
  --td-muted:#64748b;
  --td-accent:#2563eb;
  --td-accent-dark:#1d4ed8;
  --td-accent-soft:#eff6ff;
  --td-dark:#0f172a;
  --td-dark-2:#1e293b;
  --td-hero-1:#f0f7ff;
  --td-hero-2:#e0f2fe;
  --td-cta-bg:#f0f7ff;
  --td-cta-border:#bfdbfe;
  --td-container:1200px;
  --td-gutter:20px;
  --td-radius:12px;
  --td-font:"Inter",system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
}

*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:82px}
body{
  margin:0;
  background:var(--td-bg);
  color:var(--td-text);
  font-family:var(--td-font);
  font-size:16px;
  line-height:1.5;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
img{max-width:100%}
h1,h2,h3,h4,h5,p,ul,ol,figure{margin:0}
a{color:var(--td-accent);text-decoration:none}
a:hover{color:var(--td-accent-dark)}
:focus-visible{outline:2px solid var(--td-accent);outline-offset:2px;border-radius:4px}
section[id]{scroll-margin-top:88px}

.td-sr-only{
  position:absolute;width:1px;height:1px;padding:0;margin:-1px;
  overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0;
}
.td-skip{
  position:fixed;left:-9999px;top:8px;z-index:100;
  background:var(--td-surface);border:1px solid var(--td-border);
  padding:8px 14px;border-radius:8px;font-weight:600;
}
.td-skip:focus{left:8px}

/* ============ container ============ */
.td-container{
  max-width:var(--td-container);
  margin:0 auto;
  padding:0 var(--td-gutter);
  width:100%;
}

/* ============ header ============ */
.td-header{
  background:var(--td-surface);
  border-bottom:1px solid var(--td-border);
  position:sticky;top:0;z-index:100;
}
.td-header__inner{
  display:flex;align-items:center;gap:28px;
  height:70px;
}
.td-logo{
  display:flex;align-items:center;gap:10px;
  font-size:20px;font-weight:700;color:var(--td-text);
  white-space:nowrap;letter-spacing:.02em;
}
.td-logo:hover{color:var(--td-accent)}
.td-logo__badge{
  width:32px;height:32px;border-radius:8px;
  background:var(--td-accent);color:#fff;
  display:inline-flex;align-items:center;justify-content:center;
  font-size:16px;
}
.td-logo__badge svg{width:18px;height:18px;fill:currentColor;stroke:none;flex:none}
.td-nav{flex:1}
.td-nav ul{list-style:none;display:flex;gap:24px;padding:0;margin:0}
.td-nav a{
  font-size:14px;font-weight:500;color:var(--td-text-soft);
  padding:6px 2px;position:relative;
}
.td-nav a:hover{color:var(--td-accent)}
.td-nav a::after{
  content:"";position:absolute;left:0;right:100%;bottom:0;
  height:2px;background:var(--td-accent);transition:right .18s ease;
}
.td-nav a:hover::after{right:0}
.td-search{
  display:flex;align-items:center;background:#f1f5f9;
  border:1px solid var(--td-border);border-radius:20px;
  padding:0 4px 0 16px;height:40px;width:220px;
}
.td-search input{
  flex:1;border:0;background:transparent;outline:none;
  font:inherit;font-size:14px;color:var(--td-text);min-width:0;
}
.td-search button{
  border:0;background:transparent;cursor:pointer;color:var(--td-muted);
  width:32px;height:32px;display:grid;place-items:center;border-radius:50%;
}
.td-search button:hover{color:var(--td-accent);background:#fff}
.td-ic{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.td-nav-toggle{
  display:none;border:1px solid var(--td-border);background:var(--td-surface);
  width:42px;height:42px;border-radius:10px;cursor:pointer;
  align-items:center;justify-content:center;color:var(--td-text);
}
.td-nav-toggle:hover{color:var(--td-accent);border-color:var(--td-border-strong)}

.td-mobile-nav{
  display:none;background:var(--td-surface);border-bottom:1px solid var(--td-border);
}
body.td-nav-open .td-mobile-nav{display:block}
.td-mobile-nav ul{list-style:none;margin:0;padding:8px 0}
.td-mobile-nav a{
  display:block;padding:12px 4px;font-size:16px;font-weight:600;color:var(--td-text-soft);
  border-bottom:1px solid var(--td-border);
}
.td-mobile-nav a:hover{color:var(--td-accent)}
.td-mobile-nav .td-search{width:100%;margin:12px 0 16px}

/* ============ sections ============ */
.td-section{padding:40px 0}
.td-section__head{
  display:flex;align-items:end;justify-content:space-between;
  gap:16px;margin-bottom:24px;flex-wrap:wrap;
}
.td-section__title{
  font-size:20px;line-height:1.3;font-weight:700;color:var(--td-text);
  display:flex;align-items:center;gap:10px;
}
.td-section__sub{margin-top:6px;font-size:14px;color:var(--td-muted)}
.td-section__action{font-size:14px;font-weight:600;color:var(--td-accent);white-space:nowrap}
.td-section__action:hover{text-decoration:underline}
.td-section__icon{flex:none;color:var(--td-accent)}

/* ============ hero ============ */
.td-hero{
  background:linear-gradient(135deg,var(--td-hero-1) 0%,var(--td-hero-2) 100%);
  padding:60px 0;
  border-bottom:1px solid var(--td-border);
}
.td-hero__inner{
  display:grid;grid-template-columns:1.2fr 1fr;gap:44px;align-items:center;
}
.td-hero__tag{
  display:block;font-size:13px;font-weight:700;letter-spacing:.04em;
  color:var(--td-accent);margin-bottom:12px;
}
.td-hero__title{
  font-size:38px;line-height:1.2;font-weight:800;color:var(--td-text);
  margin-bottom:16px;letter-spacing:-.01em;
}
.td-hero__desc{
  color:var(--td-muted);font-size:16px;line-height:1.6;
  margin-bottom:24px;max-width:540px;
}
.td-hero__badges{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:26px}
.td-hero__cta{display:flex;gap:12px;flex-wrap:wrap}
.td-badge{
  display:inline-flex;align-items:center;gap:6px;
  font-size:13px;font-weight:500;padding:6px 14px;border-radius:20px;
  background:#fff;
  box-shadow:0 1px 2px rgba(15,23,42,.05);
}
.td-badge svg{width:15px;height:15px;color:var(--td-accent)}
.td-hero__art{
  background:#fff;padding:0;border-radius:16px;
  box-shadow:0 14px 30px rgba(15,23,42,.08);
  overflow:hidden;
}
.td-hero__art svg{display:block;width:100%;height:auto}

/* ============ buttons ============ */
.td-btn{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  background:var(--td-accent);color:#fff;font-weight:600;font-size:14px;
  padding:10px 18px;border-radius:8px;border:1px solid var(--td-accent);
  transition:background .15s ease, box-shadow .15s ease;
}
.td-btn:hover{background:var(--td-accent-dark);color:#fff;box-shadow:0 6px 16px rgba(37,99,235,.2)}
.td-btn--ghost{background:#fff;color:var(--td-accent);border-color:var(--td-border-strong)}
.td-btn--ghost:hover{background:#f8fafc;color:var(--td-accent-dark);box-shadow:0 6px 16px rgba(37,99,235,.12)}

/* ============ cards ============ */
.td-card{
  background:var(--td-surface);border:1px solid var(--td-border);
  border-radius:var(--td-radius);overflow:hidden;
  display:flex;flex-direction:column;min-width:0;
  transition:transform .2s ease, box-shadow .2s ease;
}
.td-card:hover{transform:translateY(-3px);box-shadow:0 10px 20px rgba(15,23,42,.07)}
.td-card__image-link{display:block;background:#e2e8f0}
.td-card__img{
  width:100%;height:auto;display:block;object-fit:cover;
  aspect-ratio:16/9;background:#e2e8f0;
}
.td-card__img--ph::before{
  content:"TD";display:grid;place-items:center;width:100%;aspect-ratio:16/9;
  font-weight:800;font-size:20px;color:var(--td-accent);
  letter-spacing:.1em;background:var(--td-accent-soft);
}
.td-card__content{padding:16px;display:flex;flex-direction:column;flex:1;gap:12px}
.td-chip{
  display:inline-block;align-self:flex-start;
  background:var(--td-accent-soft);color:var(--td-accent);
  font-size:11px;font-weight:600;line-height:1.6;padding:2px 8px;
  border-radius:4px;margin-bottom:0;
}
.td-chip:hover{background:var(--td-accent);color:#fff}
.td-card__title{
  font-size:15px;line-height:1.4;font-weight:600;color:var(--td-text);
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
}
.td-card__title a{color:var(--td-text)}
.td-card__title a:hover{color:var(--td-accent)}
.td-card__excerpt{display:none}
.td-card__snippet{
  font-size:13px;line-height:1.5;color:var(--td-text-soft);
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
}
.td-card__meta{
  margin-top:auto;padding-top:2px;display:flex;gap:12px;align-items:center;
  font-size:12px;color:var(--td-muted);flex-wrap:wrap;
}
.td-card__date{color:var(--td-muted)}

/* ============ featured ============ */
.td-featured__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.td-featured__loading{
  grid-column:1 / -1;text-align:center;color:var(--td-muted);
  font-size:14px;padding:28px 0;
}

/* ============ categories ============ */
.td-categories__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.td-category{
  background:var(--td-surface);border:1px solid var(--td-border);
  border-radius:var(--td-radius);padding:20px;
  display:flex;flex-direction:column;gap:10px;min-width:0;
  transition:border-color .15s ease, box-shadow .15s ease;
}
.td-category:hover{border-color:var(--td-accent);box-shadow:0 4px 12px rgba(37,99,235,.1)}
.td-category__icon{
  width:40px;height:40px;border-radius:10px;background:var(--td-accent-soft);
  display:grid;place-items:center;font-size:18px;margin-bottom:2px;line-height:1;
}
.td-category__icon svg{width:20px;height:20px;color:var(--td-accent)}
.td-category__name{font-size:16px;font-weight:600;color:var(--td-text)}
.td-category__desc{
  font-size:13px;color:var(--td-muted);line-height:1.5;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
  min-height:38px;
}
.td-category__arrow{font-size:14px;font-weight:600;color:var(--td-accent);margin-top:auto}

/* ============ projects (what I build) ============ */
.td-projects__grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
.td-project-card{
  background:var(--td-dark);color:#fff;border-radius:var(--td-radius);
  padding:22px;display:flex;flex-direction:column;gap:14px;min-width:0;
  transition:transform .2s ease, box-shadow .2s ease;
}
.td-project-card:hover{transform:translateY(-3px);box-shadow:0 12px 24px rgba(15,23,42,.18)}
.td-project-card__icon{
  width:44px;height:44px;border-radius:12px;
  background:rgba(255,255,255,.09);
  display:grid;place-items:center;
}
.td-project-card__icon svg{width:24px;height:24px;color:#93c5fd}
.td-project-card__name{font-size:17px;line-height:1.3;font-weight:700}
.td-project-card__desc{font-size:13px;line-height:1.6;color:#94a3b8}
.td-project-card__tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:2px}
.td-tag{
  font-size:11px;font-weight:600;padding:3px 8px;border-radius:999px;
  background:rgba(255,255,255,.12);color:#e2e8f0;
}
.td-project-card__pill{
  font-size:11px;font-weight:600;padding:3px 8px;border-radius:999px;
  background:rgba(148,163,184,.18);color:#cbd5e1;
  align-self:flex-start;
}
.td-project-card__body{display:flex;flex-direction:column;flex:1}
.td-project-card__foot{margin-top:10px}
.td-project-card__foot .td-btn{width:100%}

/* ============ tools ============ */
.td-tools__grid{display:grid;grid-template-columns:repeat(5,1fr);gap:16px}
.td-tool{
  background:var(--td-surface);border:1px solid var(--td-border);
  border-radius:var(--td-radius);padding:16px;
  display:flex;flex-direction:column;align-items:center;text-align:center;gap:8px;
  min-width:0;transition:border-color .15s ease, transform .15s ease;
}
.td-tool:hover{border-color:var(--td-accent);transform:translateY(-3px)}
.td-tool__icon{
  width:48px;height:48px;border-radius:12px;background:#f1f5f9;
  display:grid;place-items:center;font-size:22px;line-height:1;
}
.td-tool__icon svg{width:26px;height:26px;color:var(--td-accent)}
.td-tool__name{font-size:14px;font-weight:600;color:var(--td-text)}
.td-tool__desc{font-size:12px;color:var(--td-muted);line-height:1.5}
.td-tool__link{margin-top:auto;font-size:13px;font-weight:700;color:var(--td-accent)}
.td-tool__link:hover{color:var(--td-accent-dark)}
.td-tool__soon{
  margin-top:auto;font-size:11px;font-weight:600;color:var(--td-muted);
  background:var(--td-bg);border:1px solid var(--td-border-strong);
  padding:2px 8px;border-radius:10px;
}

/* ============ latest ============ */
.td-blog{padding:8px 0 32px}
.td-blog__grid{display:block}
.td-blog__posts{min-width:0}
.td-item{
  background:var(--td-surface);border:1px solid var(--td-border);
  border-radius:10px;padding:12px 16px;
  display:flex;gap:16px;align-items:center;margin-bottom:12px;
  transition:border-color .15s ease, box-shadow .15s ease;
}
.td-item:hover{border-color:var(--td-border-strong);box-shadow:0 2px 8px rgba(15,23,42,.05)}
.td-item__thumb{
  flex:none;width:120px;height:80px;border-radius:8px;overflow:hidden;
  background:#cbd5e1;display:block;
}
.td-item__thumb img{width:100%;height:100%;object-fit:cover;display:block}
.td-item__thumb--ph{height:45px}
.td-item__content{flex:1;min-width:0}
.td-item__title{
  font-size:15px;line-height:1.45;font-weight:600;color:var(--td-text);
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
}
.td-item__title a{color:var(--td-text)}
.td-item__title a:hover{color:var(--td-accent)}
.td-item__snippet{display:none}
.td-item__meta{margin-top:6px;display:flex;gap:12px;font-size:12px;color:var(--td-muted);flex-wrap:wrap}
.td-item .td-chip{margin-bottom:6px}
.status-msg-wrap{width:100%}
.status-msg-body{
  background:var(--td-accent-soft);border:1px solid var(--td-border);
  border-radius:10px;padding:14px 16px;font-size:15px;color:var(--td-text-soft);
}

/* ============ blog / post page ============ */
.td-page-item .td-blog,.td-page-static .td-blog{padding:40px 0 56px}
.td-blog{scroll-margin-top:90px}
.td-page-archive .td-blog{padding:24px 0 56px}
.td-page-archive .td-page__title{padding-top:28px}
.td-page__title{
  font-size:28px;line-height:1.25;font-weight:800;letter-spacing:-.01em;
  padding:32px 0 8px;
}
.td-post__header{margin-bottom:20px}
.td-post__title{font-size:32px;line-height:1.25;font-weight:800;letter-spacing:-.01em}
.td-post__meta{
  margin-top:14px;display:flex;gap:14px;flex-wrap:wrap;align-items:center;
  font-size:14px;color:var(--td-muted);
}
.td-post__meta a{color:var(--td-muted);text-decoration:underline}
.td-post__meta a:hover{color:var(--td-accent)}
.td-post__body,.post-body{font-size:16px;line-height:1.7;color:var(--td-text)}
.post-body{margin-top:0}
.post-body p{margin:0 0 1em}
.post-body img{max-width:100%;height:auto;border:1px solid var(--td-border);border-radius:8px;padding:4px;background:#fff}
.post-body a{text-decoration:underline;text-underline-offset:2px}
.post-body blockquote{margin:1em 0;padding:12px 18px;background:var(--td-accent-soft);border-left:3px solid var(--td-accent);border-radius:0 8px 8px 0}
.post-body code{background:var(--td-accent-soft);color:#1e40af;padding:2px 6px;border-radius:6px;font-size:14px;font-family:ui-monospace,Consolas,Menlo,monospace}
.post-body pre{background:#0f172a;color:#e2e8f0;padding:14px 16px;border-radius:10px;overflow:auto;font-size:14px;line-height:1.6;margin:0 0 1em}
.post-body pre code{background:none;color:inherit;padding:0}
.post-body table{border-collapse:collapse;width:100%;margin:0 0 1em}
.post-body th,.post-body td{border:1px solid var(--td-border);padding:8px 10px;text-align:left}
.post-body th{background:var(--td-bg);font-weight:700}
.td-post__footer{margin-top:28px;padding-top:20px;border-top:1px solid var(--td-border)}
.td-post__tags{display:flex;flex-wrap:wrap;gap:8px}

/* ============ pagination ============ */
.td-pager{
  display:flex;justify-content:space-between;gap:16px;
  margin-top:24px;flex-wrap:wrap;
}
.td-pager__link{
  display:inline-flex;align-items:center;gap:6px;
  border:1px solid var(--td-border);background:var(--td-surface);
  color:var(--td-text-soft);font-weight:600;font-size:14px;
  padding:10px 18px;border-radius:8px;transition:border-color .15s ease, color .15s ease;
}
.td-pager__link:hover{border-color:var(--td-accent);color:var(--td-accent)}
.td-pager__empty{visibility:hidden}
.blog-feeds,.post-feeds{margin-top:24px;font-size:13px;color:var(--td-muted)}
.feed-links a{color:var(--td-accent)}

/* ============ comments ============ */
.td-comments{margin-top:32px}
.td-comments__title{font-size:20px;font-weight:800;margin-bottom:18px}
#comments .comment-thread{margin:0}
#comments .comments-content .comment{margin:14px 0 0;width:100%}
#comments .comments-content .comment-block{
  background:var(--td-surface);border:1px solid var(--td-border);
  border-radius:10px;padding:12px 14px;
}
#comments .comments-content .comment-header{font-size:13px;color:var(--td-muted)}
#comments .comments-content .user a{color:var(--td-text-soft);font-weight:700;text-decoration:none}
#comments .comments-content .user a:hover{color:var(--td-accent)}
#comments .comments-content .icon.user{display:inline-block}
#comments .comments-content .avatar-image-container{margin-right:6px}
#comments .comments-content .avatar-image-container img{border-radius:50%;width:40px;height:40px}
#comments .comments-content .comment-content{margin:6px 0 0;font-size:15px;line-height:1.6}
#comments .comments-content .comment-replies{margin-left:12px;padding-left:14px;border-left:2px solid var(--td-border)}
#comments .comments-content .comment-replybox-single{margin-left:12px}
#comments h4{
  font-size:18px;font-weight:800;margin:0 0 18px;color:var(--td-text);
  background:none;color:var(--td-text);padding:0;
}
#comments .comment-footer{font-size:13px;color:var(--td-muted)}
#comments .continue{width:100%;text-align:left}
#comments .continue a{background:var(--td-accent);color:#fff;display:inline-block;padding:8px 16px;border-radius:8px;font-weight:600}
#comment-editor{width:100% !important;border:1px solid var(--td-border);border-radius:10px}
#threaded-comment-form p{background:var(--td-accent-soft);border:1px solid var(--td-border);border-radius:10px;padding:12px 16px;font-size:14px;color:var(--td-text-soft)}
#threaded-comment-form a{color:var(--td-accent)}
.comment-form{width:100%}
.deleted-comment{color:var(--td-muted);font-style:italic}
.item-control{font-size:12px;color:var(--td-muted)}
.item-control a{color:var(--td-muted);text-decoration:underline}

/* ============ cta banner ============ */
.td-cta{
  background:var(--td-cta-bg);border:1px solid var(--td-cta-border);border-radius:12px;
  padding:24px 30px;
  display:flex;align-items:center;justify-content:space-between;
  gap:20px;flex-wrap:wrap;margin:16px 0 56px;
}
.td-cta__text h3{
  display:flex;align-items:center;gap:8px;
  font-size:18px;font-weight:700;margin-bottom:4px;color:var(--td-text);
}
.td-cta__text h3 svg{width:20px;height:20px;color:var(--td-accent);flex:none}
.td-cta__text p{font-size:14px;color:var(--td-text-soft)}

/* ============ about ============ */
.td-about__card{
  background:linear-gradient(135deg,var(--td-surface) 0%,var(--td-accent-soft) 100%);
  border:1px solid var(--td-border);border-radius:16px;
  padding:28px 30px;
  display:grid;grid-template-columns:auto 1fr;gap:26px;align-items:center;
}
.td-about__avatar{
  width:84px;height:84px;border-radius:20px;
  background:var(--td-accent);color:#fff;
  display:grid;place-items:center;
  font-size:34px;font-weight:800;flex:none;
  box-shadow:0 12px 24px rgba(37,99,235,.22);
}
.td-about__eyebrow{
  font-size:12px;font-weight:700;letter-spacing:.06em;
  text-transform:uppercase;color:var(--td-accent);display:block;margin-bottom:6px;
}
.td-about__name{font-size:24px;line-height:1.25;font-weight:800;color:var(--td-text)}
.td-about__role{font-size:14px;font-weight:600;color:var(--td-text-soft);margin-top:4px}
.td-about__text{margin-top:12px;font-size:15px;line-height:1.7;color:var(--td-text-soft);max-width:760px}
.td-about__links{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}
.td-about__links a{
  font-size:13px;font-weight:600;color:var(--td-accent);
  border:1px solid var(--td-border);background:var(--td-surface);
  padding:7px 14px;border-radius:8px;transition:border-color .15s ease, box-shadow .15s ease;
}
.td-about__links a:hover{border-color:var(--td-accent);box-shadow:0 4px 12px rgba(37,99,235,.1)}

/* ============ footer ============ */
.td-footer{
  background:#0b0f19;color:#94a3b8;padding:40px 0 20px;
  font-size:14px;margin-top:16px;
}
.td-footer__top{
  display:flex;justify-content:space-between;align-items:center;
  gap:24px;flex-wrap:wrap;
  border-bottom:1px solid #1e293b;padding-bottom:20px;margin-bottom:20px;
}
.td-footer__brand{
  display:flex;align-items:center;gap:10px;
  font-size:20px;font-weight:700;color:#fff;
}
.td-footer__brand:hover{color:#fff}
.td-footer__links ul{list-style:none;display:flex;gap:18px;padding:0;margin:0;flex-wrap:wrap}
.td-footer__links a{color:#94a3b8}
.td-footer__links a:hover{color:#fff}
.td-footer__bottom{
  display:flex;justify-content:space-between;align-items:center;
  gap:12px;flex-wrap:wrap;font-size:13px;
}
.td-footer__attribution{font-size:12px;opacity:.9}
.td-footer__attribution a{color:#94a3b8;text-decoration:underline}

/* ============ responsive ============ */
@media (max-width:1199px){
  .td-tools__grid{grid-template-columns:repeat(3,1fr)}
}
@media (max-width:991px){
  .td-featured__grid{grid-template-columns:repeat(2,1fr)}
  .td-categories__grid{grid-template-columns:repeat(2,1fr)}
  .td-projects__grid{grid-template-columns:repeat(2,1fr)}
  .td-hero__inner{grid-template-columns:1fr;gap:28px}
  .td-hero__art{max-width:560px}
}
@media (max-width:767px){
  .td-container{padding:0 18px}
  .td-header__inner{height:60px;gap:12px}
  .td-nav{display:none}
  .td-search{display:none}
  .td-nav-toggle{display:flex}
  .td-section{padding:32px 0}
  .td-section__title{font-size:18px}
  .td-hero{padding:40px 0}
  .td-hero__title{font-size:30px}
  .td-featured__grid{grid-template-columns:1fr}
  .td-categories__grid{grid-template-columns:repeat(2,1fr)}
  .td-projects__grid{grid-template-columns:1fr}
  .td-tools__grid{grid-template-columns:repeat(2,1fr)}
  .td-blog{padding:8px 0 24px}
  .td-page-item .td-blog,.td-page-static .td-blog{padding:28px 0 40px}
  .td-post__title{font-size:28px}
  .td-item{padding:12px;gap:12px}
  .td-item__thumb{width:92px;height:62px}
  .td-cta{padding:20px}
  .td-about__card{grid-template-columns:1fr;text-align:left;padding:24px 22px}
  .td-footer{padding:32px 0 20px;font-size:13px}
}
@media (max-width:479px){
  .td-categories__grid{grid-template-columns:1fr}
}
]]></b:skin>
