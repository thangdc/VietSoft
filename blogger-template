<b:include data='blog' name='google-analytics'/>

<script>
//<![CDATA[
(function() {
  "use strict";
  var CFG = (window.TD_CONFIG) ? window.TD_CONFIG : {};
  var HOME = "<data:blog.homepageUrl/>";

  function $(id) { return document.getElementById(id); }
  function qsa(sel, root) { return Array.prototype.slice.call((root || document).querySelectorAll(sel)); }

  /* ---------- mobile nav ---------- */
  var navToggle = $("td-nav-toggle");
  var mobileNav = $("td-mobile-nav");
  function closeNav() {
    if (!navToggle) { return; }
    document.body.classList.remove("td-nav-open");
    navToggle.setAttribute("aria-expanded", "false");
    if (mobileNav) { mobileNav.hidden = true; }
  }
  if (navToggle && mobileNav) {
    navToggle.addEventListener("click", function(ev) {
      ev.preventDefault();
      var open = document.body.classList.toggle("td-nav-open");
      navToggle.setAttribute("aria-expanded", open ? "true" : "false");
      mobileNav.hidden = !open;
    });
    document.addEventListener("click", function(ev) {
      if (document.body.classList.contains("td-nav-open") &&
          !mobileNav.contains(ev.target) && !navToggle.contains(ev.target)) {
        closeNav();
      }
    });
    window.addEventListener("resize", function() {
      if (window.innerWidth >= 769) { closeNav(); }
    });
  }

  /* ---------- meta helpers ---------- */
  function hasContent(el) { return el && el.childNodes.length > 0; }
  function fmtDate(iso) {
    try {
      var d = new Date(iso);
      if (isNaN(d.getTime())) { return ""; }
      return d.toLocaleDateString("vi-VN", { day: "2-digit", month: "long", year: "numeric" });
    } catch (e) { return ""; }
  }
  function wordCount(t) {
    var m = (t || "").match(/\S+/g);
    return m ? m.length : 0;
  }
  function readTimeText(t) {
    var w = wordCount(t);
    if (w < 40) { return ""; }
    return Math.max(1, Math.round(w / 200)) + " phút đọc";
  }
  function fillDates(root) {
    qsa("[data-td-date]", root).forEach(function(el) {
      if (hasContent(el)) { return; }
      el.textContent = fmtDate(el.getAttribute("datetime"));
    });
  }
  function fillTimes(root) {
    qsa("[data-td-rt]", root).forEach(function(el) {
      if (hasContent(el)) { return; }
      var wrap = el.closest(".td-card") || el.closest(".td-item");
      if (!wrap) { return; }
      var ex = wrap.querySelector(".td-card__excerpt") || wrap.querySelector(".td-item__snippet");
      el.textContent = (ex) ? readTimeText(ex.textContent) : "";
    });
  }
  function fillMeta(root) { fillDates(root); fillTimes(root); }

  /* ---------- image upgrade (72px thumbs -> 16:9 card size) ---------- */
  function upgradeImageUrl(img, width, height) {
    var src = img.getAttribute("src") || "";
    if (!src) { return; }

    if (src.indexOf("i.ytimg.com/") !== -1 && /\/default\.jpg(?:\?|$)/.test(src)) {
      img.setAttribute("src", src.replace("/default.jpg", "/hqdefault.jpg"));
      return;
    }

    var target = "=w" + width + "-h" + height + "-c";
    var m = src.match(/=w\d+-h\d+[-a-zA-Z0-9-]*/);
    if (m) {
      img.setAttribute("src", src.replace(m[0], target));
    } else if (src.indexOf("s72-c") !== -1) {
      img.setAttribute("src", src.replace("s72-c", target.substring(1)));
    } else if (src.indexOf("/s72/") !== -1) {
      img.setAttribute("src", src.replace("/s72/", "/w" + width + "-h" + height + "/"));
    }
  }

  function upgradeCardImages(root) {
    qsa(".td-card__img", root).forEach(function(img) {
      upgradeImageUrl(img, 640, 360);
    });
    qsa(".td-item__thumb img, .mobile-index-thumbnail img", root).forEach(function(img) {
      upgradeImageUrl(img, 640, 360);
    });
  }

  /* ---------- small DOM helpers ---------- */
  function makeEl(tag, cls, text) {
    var n = document.createElement(tag);
    if (cls) { n.className = cls; }
    if (text !== undefined && text !== null) { n.textContent = text; }
    return n;
  }
  function hideSection(gridId) {
    var grid = $(gridId);
    if (grid) {
      var sec = grid.closest("section");
      if (sec) { sec.setAttribute("hidden", ""); }
    }
  }
  function esc(s) {
    return String(s == null ? "" : s)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }
  function norm(s) {
    return String(s == null ? "" : s).toLowerCase().replace(/\s+/g, " ").trim();
  }
  function stripHtml(h) {
    var d = document.createElement("div");
    d.innerHTML = (h || "");
    return d.textContent || "";
  }

  /* ---------- label chip colors (mockup: Python=amber, Tools=purple...) ---------- */
  var CHIP_COLORS = {
    "ai": "#eff6ff|#2563eb",
    "automation": "#dcfce7|#15803d",
    "python": "#fef3c7|#d97706",
    "tools": "#fae8ff|#a21caf",
    "ocr": "#e0f2fe|#0369a1",
    "local ai": "#e0e7ff|#4338ca"
  };
  function chipColorize(el) {
    var t = norm(el.textContent);
    var map = CHIP_COLORS[t] || CHIP_COLORS[t.replace(/^ai\s*\+\s*/i, "")] || "";
    if (!map) { return; }
    var parts = map.split("|");
    el.style.background = parts[0];
    el.style.color = parts[1];
  }
  function colorizeChips(root) {
    qsa(".td-chip", root).forEach(function(el) {
      if (el.getAttribute("data-colored")) { return; }
      chipColorize(el);
      el.setAttribute("data-colored", "1");
    });
  }

  /* ---------- tools ---------- */
  var ICONS = {
    ocr: "<svg class='td-ic td-ic--tool' viewBox='0 0 24 24' aria-hidden='true'><path d='M3 7V5a2 2 0 0 1 2-2h2'/><path d='M17 3h2a2 2 0 0 1 2 2v2'/><path d='M21 17v2a2 2 0 0 1-2 2h-2'/><path d='M7 21H5a2 2 0 0 1-2-2v-2'/><circle cx='12' cy='12' r='3'/></svg>",
    image2excel: "<svg class='td-ic td-ic--tool' viewBox='0 0 24 24' aria-hidden='true'><rect width='18' height='18' x='3' y='3' rx='2' ry='2'/><circle cx='9' cy='9' r='2'/><path d='m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21'/></svg>",
    pdf2excel: "<svg class='td-ic td-ic--tool' viewBox='0 0 24 24' aria-hidden='true'><path d='M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z'/><path d='M14 2v4a2 2 0 0 0 2 2h4'/><path d='M10 9H8'/><path d='M16 13H8'/><path d='M16 17H8'/></svg>",
    qr: "<svg class='td-ic td-ic--tool' viewBox='0 0 24 24' aria-hidden='true'><rect width='5' height='5' x='3' y='3' rx='1'/><rect width='5' height='5' x='16' y='3' rx='1'/><rect width='5' height='5' x='3' y='16' rx='1'/><path d='M21 16h-3a2 2 0 0 0-2 2v3'/><path d='M21 21v.01'/><path d='M12 7v3a2 2 0 0 1-2 2H7'/><path d='M3 12h.01'/><path d='M12 3h.01'/><path d='M12 16v.01'/><path d='M16 12h1'/><path d='M21 12v.01'/><path d='M12 21v-1'/></svg>",
    excel: "<svg class='td-ic td-ic--tool' viewBox='0 0 24 24' aria-hidden='true'><path d='M3 3v16a2 2 0 0 0 2 2h16'/><path d='M18 17V9'/><path d='M13 17V5'/><path d='M8 17v-3'/></svg>"
  };
  function iconSvg(key) { return ICONS[key] || ICONS.ocr; }
  function renderTools() {
    var grid = $("td-tools-grid");
    if (!grid) { return; }
    var tools = CFG.tools || [];
    if (!tools.length) { hideSection("td-tools-grid"); return; }
    tools.forEach(function(t) {
      if (!t || !t.name) { return; }
      var isLive = t.status === "live" && !!t.url;
      var card = makeEl("article", isLive ? "td-tool" : "td-tool td-tool--soon");
      var icon = makeEl("div", "td-tool__icon");
      icon.innerHTML = iconSvg(t.icon);
      card.appendChild(icon);
      card.appendChild(makeEl("h3", "td-tool__name", t.name));
      card.appendChild(makeEl("p", "td-tool__desc", t.description || ""));
      if (isLive) {
        var a = makeEl("a", "td-tool__link", "Mở công cụ →");
        a.setAttribute("href", t.url);
        card.appendChild(a);
      } else {
        card.appendChild(makeEl("span", "td-tool__soon", "Coming soon"));
      }
      grid.appendChild(card);
    });
  }

  /* ---------- projects (what I build) ---------- */
  var PROJ_ICONS = {
    ai: "<svg class='td-ic' viewBox='0 0 24 24' aria-hidden='true'><rect width='18' height='10' x='3' y='11' rx='2'/><path d='M12 7V4'/><path d='M10 4h4'/><path d='M12 21v-3'/><path d='M8 21h8'/><path d='M12 11v3'/><path d='M10 14l-1 3'/><path d='M14 14l1 3'/><path d='M8.5 3.5 7 5'/><path d='M15.5 3.5 17 5'/></svg>",
    browser: "<svg class='td-ic' viewBox='0 0 24 24' aria-hidden='true'><circle cx='12' cy='12' r='10'/><path d='M2 12h20'/><path d='M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z'/></svg>",
    qr: ICONS.qr,
    ocr: ICONS.ocr,
    excel: ICONS.excel,
    tool: "<svg class='td-ic' viewBox='0 0 24 24' aria-hidden='true'><path d='M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z'/></svg>"
  };
  function renderProjects() {
    var grid = $("td-projects-grid");
    if (!grid) { return; }
    var list = CFG.projects || [];
    if (!list.length) {
      var sec = grid.closest("section");
      if (sec) { sec.setAttribute("hidden", ""); }
      return;
    }
    grid.innerHTML = "";
    list.forEach(function(p) {
      if (!p || !p.title) { return; }
      var isLive = !!(p.url);
      var card = makeEl("article", "td-project-card");
      var head = makeEl("div", "td-project-card__head");
      var icon = makeEl("div", "td-project-card__icon");
      icon.innerHTML = PROJ_ICONS[p.icon] || PROJ_ICONS.tool;
      head.appendChild(icon);
      card.appendChild(head);
      var body = makeEl("div", "td-project-card__body");
      body.appendChild(makeEl("h3", "td-project-card__name", p.title));
      body.appendChild(makeEl("p", "td-project-card__desc", p.description || ""));
      var tags = makeEl("div", "td-project-card__tags");
      (p.tags || []).forEach(function(t) { tags.appendChild(makeEl("span", "td-tag", t)); });
      body.appendChild(tags);
      card.appendChild(body);
      var foot = makeEl("div", "td-project-card__foot");
      if (isLive) {
        var a = makeEl("a", "td-btn", "Xem dự án →");
        a.setAttribute("href", p.url);
        foot.appendChild(a);
      } else {
        foot.appendChild(makeEl("span", "td-project-card__pill", "Đang phát triển"));
      }
      card.appendChild(foot);
      grid.appendChild(card);
    });
  }

  /* ---------- about ---------- */
  function renderAbout() {
    var a = CFG.about || {};
    var set = function(id, v) {
      var el = $(id);
      if (el && v) { el.textContent = v; }
    };
    if (a.name) { set("td-about-name", a.name); }
    if (a.role) { set("td-about-role", a.role); }
    if (a.description) { set("td-about-text", a.description); }
  }

  /* ---------- boot ---------- */
  fillMeta(document);
  upgradeCardImages(document);
  colorizeChips(document);
  renderTools();
  renderProjects();
  renderAbout();
})();
//]]>
</script>

</body>
